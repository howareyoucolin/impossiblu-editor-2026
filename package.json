{
  "name": "electron-local-file-viewer-2026",
  "version": "2.0.0",
  "private": true,
  "description": "Minimal Electron hello world app",
  "author": "Colin Zhou",
  "main": "main.js",
  "scripts": {
    "build": "vite build",
    "dev": "concurrently -k \"npm:dev:react\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:4000 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:4000/react.html electron .",
    "start": "electron .",
    "dev:react": "vite --host 127.0.0.1 --port 4000",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.example.electronlocalfileviewer2026",
    "productName": "ImpossibluEditor",
    "icon": "src/assets/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "src/assets/icon.png",
      "react-dist/**/*",
      "index.html",
      "package.json"
    ],
    "mac": {
      "target": [
        "zip"
      ]
    }
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.5",
    "wait-on": "^8.0.3"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@uiw/react-codemirror": "^4.25.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}
